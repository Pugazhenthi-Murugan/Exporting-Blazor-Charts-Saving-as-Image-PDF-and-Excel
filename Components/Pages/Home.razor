@page "/"
@rendermode InteractiveServer
@using Syncfusion.Blazor.Charts

<div style="display: flex; justify-content: space-between; align-items: center; gap: 20px;">
    <div class="control-section col-lg-9 sb-property-border" style="flex-grow: 1;">
        <SfChart @ref="@ChartInstance" Title="Top 10 Countries Using Solar Power">
            <ChartTitleStyle TextOverflow="TextOverflow.Wrap"></ChartTitleStyle>
            <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>
            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" Interval="1" LabelIntersectAction="LabelIntersectAction.Trim" LabelRotation="-45">
                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
            </ChartPrimaryXAxis>
            <ChartPrimaryYAxis Minimum="0" Maximum="40" Interval="10" Title="Measurements (in Gigawatt)" LabelFormat="{value}GW">
                <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                <ChartAxisMajorGridLines Width="2"></ChartAxisMajorGridLines>
                <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
            </ChartPrimaryYAxis>
            <ChartSeriesCollection>
                <ChartSeries DataSource="@ChartPoints" XName="Country" YName="GigaWatts" Type="ChartSeriesType.Column" PointColorMapping="Color">
                    <ChartCornerRadius TopLeft="4" TopRight="4"></ChartCornerRadius>
                    <ChartMarker>
                        <ChartDataLabel Visible="true" Name=" DataLabelMappingName" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                            <ChartDataLabelFont FontWeight="600" Size="9px" Color="#ffffff"></ChartDataLabelFont>
                        </ChartDataLabel>
                    </ChartMarker>
                </ChartSeries>
            </ChartSeriesCollection>
        </SfChart>
    </div>
    <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 10px;">
        <button style="padding: 8px 12px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; width: 150px;"
                @onclick="ExportAsImage">
            Export as Image
        </button>

        <button style="padding: 8px 12px; background-color: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; width: 150px;"
                @onclick="ExportAsPDF">
            Export as PDF
        </button>

        <button style="padding: 8px 12px; background-color: #ffc107; color: black; border: none; border-radius: 5px; cursor: pointer; width: 150px;"
                @onclick="ExportAsExcel">
            Export as Excel
        </button>
    </div>
</div>

@code {
    private SfChart? ChartInstance;
    public List<ExportData> ChartPoints { get; set; } = new List<ExportData>
    {
        new ExportData {Country="India", GigaWatts = 35.5, DataLabelMappingName="35.5", Color="#FFD700"},
        new ExportData {Country="China", GigaWatts = 18.3, DataLabelMappingName="18.3", Color="#FFA500"},
        new ExportData {Country="Italy", GigaWatts = 17.6, DataLabelMappingName="17.6", Color="#FF6347"},
        new ExportData {Country="Japan", GigaWatts = 13.6, DataLabelMappingName="13.6", Color="#FF4500"},
        new ExportData {Country="United State", GigaWatts = 12, DataLabelMappingName="12", Color="#FF0000"},
        new ExportData {Country="Spain", GigaWatts = 5.6, DataLabelMappingName="5.6", Color="#DC143C"},
        new ExportData {Country="France", GigaWatts = 4.6, DataLabelMappingName="4.6", Color="#B22222"},
        new ExportData {Country="Australia", GigaWatts = 3.3, DataLabelMappingName="3.3", Color="#8B0000"},
        new ExportData {Country="Belgium", GigaWatts = 3, DataLabelMappingName="3", Color="#800000"},
        new ExportData {Country="United Kingdom", GigaWatts = 2.9, DataLabelMappingName="2.9", Color="#A52A2A"},
    };
    private async Task ExportAsImage()
    {
        if (ChartInstance != null)
        {
            await ChartInstance.ExportAsync(ExportType.PNG, "ChartImage");
        }
    }
    private async Task ExportAsPDF()
    {
        if (ChartInstance != null)
        {
            await ChartInstance.ExportAsync(ExportType.PDF, "ChartReport");
        }
    }
    private async Task ExportAsExcel()
    {
        if (ChartInstance != null)
        {
            await ChartInstance.ExportAsync(ExportType.XLSX, "ChartData");
        }
    }
    public class ExportData
    {
        public string Country { get; set; }
        public double GigaWatts { get; set; }
        public string DataLabelMappingName { get; set; }
        public string Color { get; set; }
    }
}
